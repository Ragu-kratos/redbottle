{
  "name": "redbottle-institute",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private institute management -- courses, batches, students, attendance, fees and trainers. Lit + htmx + Tailwind frontend backed by Firebase Auth and function-rendered HTML fragments",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emu": "firebase emulators:start --only auth,functions,firestore --project redbottle-institute",
    "seed": "curl -s -X POST http://127.0.0.1:5001/redbottle-institute/asia-south1/testBed-seed"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "htmx.org": "^2.0.10",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase-tools": "^15.26.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1"
  }
}
