rules_version = '2';

// The client never talks to Firestore directly -- only the Cloud Function
// (via the Admin SDK, which bypasses these rules) reads it, after verifying
// the caller's ID token itself. Deny all direct client access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
