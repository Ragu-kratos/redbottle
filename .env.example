# Firebase web app config (Project settings -> General -> Your apps -> SDK setup).
# projectId MUST be exactly "redbottle-institute" -- the Cloud Function verifies
# the ID token's `aud` claim against it. apiKey can stay a dummy value while the
# app talks to the Auth emulator, but fill in the real values before deploying.
VITE_FIREBASE_API_KEY=emulator-fake-key
VITE_FIREBASE_AUTH_DOMAIN=redbottle-institute.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=redbottle-institute
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Point the web SDK at local emulators instead of production. Leave "1" for local dev.
VITE_USE_EMULATORS=1

# Cloud Functions emulator, region asia-south1 (matches Firestore's location).
# This is the region root, not a single function's URL -- functions deploy as
# groups (see functions/endpoints/index.js), e.g. `api-students`,
# `api-attendance`, `testBed-seed`, and services/api.js appends each
# function's name per endpoint. FN_ORIGIN is derived from this URL -- there is
# no separate VITE_FN_ORIGIN var to keep in sync.
VITE_FN_BASE=http://127.0.0.1:5001/redbottle-institute/asia-south1
